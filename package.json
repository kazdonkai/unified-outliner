    "@codemirror/view": "^6.38.6",
    "@types/node": "^20.19.43",
    "esbuild": "^0.21.5",
    "obsidian": "^1.13.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  }
}
