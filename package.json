{
  "name": "unified-outliner",
  "version": "0.2.1",
  "description": "Move, reorganize, and locally edit heading sections and list subtrees.",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kazdonkai/unified-outliner.git"
  },
